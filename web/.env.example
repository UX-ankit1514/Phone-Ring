VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=arnifi-phone-bell-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arnifi-phone-bell-dev
VITE_FIREBASE_STORAGE_BUCKET=arnifi-phone-bell-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The API runs on Cloudflare Workers. Leave as /api/v1 for local development
# (vite proxies it to `npm run dev:worker`); set the deployed worker URL for
# builds, e.g. https://arnifi-phone-bell-dev.<subdomain>.workers.dev/api/v1
VITE_API_BASE_URL=/api/v1
VITE_TARGET_DEVICE_ID=uae-phone-01
VITE_ALLOWED_EMAIL_DOMAIN=arnifi.com
VITE_USE_FIREBASE_EMULATORS=false
VITE_DEMO_MODE=false

