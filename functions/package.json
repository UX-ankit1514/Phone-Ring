{
  "name": "@arnifi/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build:contracts": "npm --prefix ../packages/contracts run build",
    "build": "npm run build:contracts && tsc -p tsconfig.json",
    "typecheck": "npm run build:contracts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:rules": "vitest run tests/firestoreRules.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arnifi/contracts": "file:../packages/contracts",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/supertest": "^6.0.2",
    "firebase": "^12.19.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
