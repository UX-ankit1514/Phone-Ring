# Copy to worker/.dev.vars for local development. Never commit the real values.
# In Cloudflare these are stored as encrypted secrets:
#   wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON --env dev
#   wrangler secret put DEVICE_ENROLLMENT_CODE --env dev
GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"firebase-adminsdk@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
DEVICE_ENROLLMENT_CODE="replace-with-a-long-one-time-code"
